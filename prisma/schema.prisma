// ============================================================
// SCHÉMA PRISMA — Portail Employé Multi-Entreprise
// ============================================================
// Règle d'or : presque CHAQUE table contient organizationId.
// Aucune requête ne doit jamais lire/écrire sans filtrer par
// organizationId. C'est ce qui garantit l'isolation entre
// l'Entreprise A et l'Entreprise B.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// RÔLES — définit ce que chaque utilisateur a le droit de faire
// ------------------------------------------------------------
enum Role {
  SUPER_ADMIN   // vous — gère toutes les organisations clientes
  ORG_ADMIN     // admin/RH de l'entreprise cliente
  MANAGER       // chef de département / gérant
  EMPLOYEE      // employé standard
}

// Statut de l'organisation côté PLATEFORME (pas côté RH — voir UserStatus
// pour désactiver un employé). Sert au propriétaire de l'application
// (SUPER_ADMIN, voir AUDIT.md 7.20) à couper l'accès d'une entreprise
// cliente, typiquement en cas de non-paiement. Une organisation SUSPENDED
// ne peut plus se connecter (lib/auth.ts) ni utiliser l'app (lib/session-guard.ts).
enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum ReportStatus {
  NEW
  SEEN
  IN_PROGRESS
  RESOLVED
}

enum AbsenceStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED // annulée par l'employé lui-même (Congés, AUDIT.md 7.30)
}

enum JobPostingStatus {
  OPEN
  CLOSED
}

enum ApplicationStatus {
  RECEIVED
  IN_REVIEW
  ACCEPTED
  REJECTED
}

enum SurveyStatus {
  OPEN    // les employés peuvent répondre
  CLOSED  // fermé manuellement par un admin, ou date de clôture dépassée (voir lib/surveys.ts)
}

enum SupportTicketStatus {
  OPEN      // en attente / en cours
  RESOLVED  // marqué résolu par le propriétaire de la plateforme
}

// Départs d'employés — Employee Retention Intelligence (voir AUDIT.md 7.26)
enum DepartureType {
  RESIGNATION      // démission
  END_OF_CONTRACT  // fin de contrat / CDD
  DISMISSAL        // licenciement / renvoi
  RETIREMENT       // retraite
  OTHER
}

enum DepartureStatus {
  PENDING_SURVEY   // départ enregistré par un admin, questionnaire envoyé à l'employé, pas encore rempli
  COMPLETED        // questionnaire rempli
  NO_SURVEY        // départ enregistré sans questionnaire (ex. licenciement)
}

enum UserStatus {
  ACTIVE
  DISABLED   // "supprimé" par l'admin -> on désactive, on ne supprime jamais vraiment (traçabilité)
}

// ------------------------------------------------------------
// ORGANIZATION — une entreprise cliente = un tenant
// ------------------------------------------------------------
model Organization {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique // utilisé dans l'URL, ex: acme.monapp.com ou /org/acme
  plan       String   @default("free") // free / pro / enterprise (pour la facturation future)
  inviteCode String?  @unique // code d'auto-inscription employé, ex "XK7P-2QRT" (voir lib/invite-code.ts, AUDIT.md 7.18) ; nullable pour les organisations créées avant cette fonctionnalité, généré au premier affichage de /dashboard/settings
  logoData       Bytes?    // logo propre à CETTE organisation, affiché à ses employés une fois connectés (voir AUDIT.md 7.19) ; null = utilise le logo par défaut de la plateforme (public/logo-mark-white.png)
  logoMimeType   String?   // type MIME du logo, ex "image/png" — null tant qu'aucun logo n'a été téléversé
  logoUpdatedAt  DateTime? // sert à invalider le cache navigateur de l'image après un changement (voir GET /api/organization/logo)
  status         OrganizationStatus @default(ACTIVE) // géré depuis /platform par le SUPER_ADMIN (voir AUDIT.md 7.20)
  // Entreprise fictive de démonstration (AUDIT.md 7.43) : visitée depuis la
  // page d'accueil (« Voir la démo »), en LECTURE SEULE (middleware.ts).
  isDemo         Boolean   @default(false)
  // Essai gratuit (AUDIT.md 7.44) : 30 jours à la création de l'entreprise.
  // null = pas en essai (client confirmé, ou entreprise créée avant). Rappels
  // au propriétaire 5 jours avant la fin, puis le jour de la fin.
  trialEndsAt          DateTime?
  trialReminderSentAt  DateTime?
  trialEndedNotifiedAt DateTime?
  // Facturation Stripe (AUDIT.md 7.45) : par employé actif / mois.
  stripeCustomerId         String?   @unique
  stripeSubscriptionId     String?   @unique
  stripeSubscriptionItemId String?
  billingStatus            String?   // statut Stripe : trialing | active | past_due | unpaid | canceled | incomplete…
  billingQuantity          Int?      // employés actifs facturés
  billingPeriodEnd         DateTime? // prochain paiement
  billingGraceUntil        DateTime? // suspension automatique à cette date si rien n'est payé
  suspendedReason          String?   // "billing" (automatique, réactivée dès le paiement) | "manual"
  suspendedAt    DateTime? // date de la dernière suspension, affichée dans /platform/organizations
  // Admin PRINCIPAL de l'organisation (voir AUDIT.md 7.22) : le seul qui peut
  // ajouter/désactiver/retirer/remplacer les 2 co-admins. Nullable pour les
  // organisations créées avant cette fonctionnalité : rempli paresseusement
  // (ORG_ADMIN le plus ancien) par lib/admins.ts au premier besoin.
  primaryAdminId String?
  // Confidentialité / Loi 25 (voir AUDIT.md 7.28) : durée de conservation des
  // réponses NOMINATIVES (questionnaires de départ, sondages nominatifs) et
  // responsable de la protection des renseignements personnels affiché aux
  // employés. Responsable vide = l'admin principal (par défaut, la loi désigne
  // la personne ayant la plus haute autorité dans l'entreprise).
  // Durée : AUCUNE valeur par défaut, c'est l'admin principal qui la choisit
  // (6, 12, 24, 36 ou 60 mois). Tant qu'elle est vide, rien n'est supprimé.
  dataRetentionMonths Int?
  privacyOfficerName  String?
  privacyOfficerEmail String?
  lastPrivacyPurgeAt  DateTime? // dernière exécution de la suppression automatique
  // Langue par défaut des comptes qui n'ont pas choisi la leur (FR/EN, AUDIT.md 7.29).
  defaultLocale       String    @default("fr")
  // Mois de début de l'année de congés (1 = janvier ; 5 = mai, année de référence
  // des vacances au Québec). Voir AUDIT.md 7.30.
  leaveYearStartMonth Int       @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  departments      Department[]
  users            User[]
  announcements    Announcement[]
  jobPostings      JobPosting[]
  fileUploads      FileUpload[]
  auditLogs        AuditLog[]
  invitations      Invitation[]
  notifications    Notification[]
  surveys          Survey[]
  supportTickets   SupportTicket[]
  departures       Departure[]
  leaveTypes       LeaveType[]
  companyLeaves    CompanyLeave[]
  shifts           Shift[]
  scheduleFiles    ScheduleFile[]
  shiftSwaps       ShiftSwap[]

  @@map("organizations")
}

// ------------------------------------------------------------
// DEPARTMENT
// ------------------------------------------------------------
model Department {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  color          String   @default("#3F6FB0") // couleur du badge à côté du nom (AUDIT.md 7.34)
  createdAt      DateTime @default(now())

  users    User[]
  managers DepartmentManager[]
  scheduleFiles ScheduleFile[]

  @@unique([organizationId, name]) // pas deux départements du même nom dans la même entreprise
  @@index([organizationId])
  @@map("departments")
}

// Responsable(s) d'un département (AUDIT.md 7.34) : nommés par l'admin
// principal ; rôle MANAGER tant qu'ils gèrent au moins un département.
// Un responsable n'a pas besoin d'être membre du département qu'il gère.
model DepartmentManager {
  organizationId String
  departmentId   String
  department     Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime   @default(now())

  @@id([departmentId, userId])
  @@index([userId])
  @@index([organizationId])
  @@map("department_managers")
}

// ------------------------------------------------------------
// USER — un employé, gérant, ou admin, toujours lié à 1 organisation
// ------------------------------------------------------------
model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String?
  department     Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  // Courriel facultatif depuis AUDIT.md 7.40 : un employé peut s'inscrire et
  // se connecter avec seulement son numéro de téléphone.
  email          String?
  phone          String?      // format international, ex. "+15145551234" (lib/phone.ts)
  passwordHash   String
  firstName      String
  lastName       String
  role           Role         @default(EMPLOYEE)
  status         UserStatus   @default(ACTIVE)
  avatarUrl      String?
  hireDate       DateTime?    @default(now()) // utile pour "nouvelles recrues"
  locale         String?      // "fr" | "en" choisi par la personne (null = langue par défaut de l'entreprise, AUDIT.md 7.29)
  departmentConfirmedAt DateTime? // département choisi par la personne (inscription ou fenêtre unique à la connexion, AUDIT.md 7.34)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relations où l'utilisateur est l'AUTEUR
  reportsSubmitted     Report[]          @relation("ReportSubmitter")
  absenceRequests      AbsenceRequest[]
  jobApplications      JobApplication[]
  reviewsWritten       Review[]
  messagesSent         Message[]         @relation("MessageSender")
  messagesReceived     Message[]         @relation("MessageReceiver")
  announcementsPosted  Announcement[]    @relation("AnnouncementAuthor")
  filesUploaded        FileUpload[]      @relation("FileUploader")
  notifications        Notification[]
  leaveAdjustments     LeaveBalanceAdjustment[]
  managedDepartments   DepartmentManager[]
  pushSubscriptions    PushSubscription[]
  surveysCreated       Survey[]              @relation("SurveyAuthor")
  surveyParticipations SurveyParticipation[]
  supportTickets       SupportTicket[]       @relation("SupportTicketAuthor")
  supportMessages      SupportMessage[]      @relation("SupportMessageSender")
  departures           Departure[]           @relation("DepartureEmployee")
  departuresRecorded   Departure[]           @relation("DepartureRecorder")
  passwordResetTokens  PasswordResetToken[]
  shifts               Shift[]
  shiftSwapsOffered    ShiftSwap[]           @relation("ShiftSwapFrom")
  shiftSwapsTargeted   ShiftSwap[]           @relation("ShiftSwapTarget")
  shiftSwapsTaken      ShiftSwap[]           @relation("ShiftSwapTaker")

  // Un email doit être unique PAR organisation (pas globalement,
  // car la même personne pourrait théoriquement travailler dans 2 entreprises clientes différentes avec le même email)
  @@unique([organizationId, email])
  @@unique([organizationId, phone]) // un numéro par personne dans une même entreprise
  @@index([organizationId])
  @@index([organizationId, departmentId])
  @@map("users")
}

// ------------------------------------------------------------
// INVITATION — pour inviter un employé avant qu'il ait un compte
// ------------------------------------------------------------
model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           Role         @default(EMPLOYEE)
  token          String       @unique // lien sécurisé envoyé par email
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@map("invitations")
}

// ------------------------------------------------------------
// REPORT — signalement d'un problème (employé -> gérant/admin)
// ------------------------------------------------------------
model Report {
  id             String       @id @default(cuid())
  organizationId String
  submitterId    String
  submitter      User         @relation("ReportSubmitter", fields: [submitterId], references: [id], onDelete: Cascade)

  title          String
  description    String
  isAnonymous    Boolean      @default(false) // idée additionnelle : anonymat optionnel
  status         ReportStatus @default(NEW)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("reports")
}

// ------------------------------------------------------------
// ABSENCE REQUEST — déclaration d'absence
// ------------------------------------------------------------
model AbsenceRequest {
  id             String        @id @default(cuid())
  organizationId String
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  startDate      DateTime
  endDate        DateTime
  reason         String        @default("") // commentaire facultatif de l'employé (obligatoire avant 7.30)
  status         AbsenceStatus @default(PENDING)

  // --- Congés (AUDIT.md 7.30) ---
  leaveTypeId    String?       // null = demande créée avant les types de congés (affichée « Autre », hors soldes)
  leaveType      LeaveType?    @relation(fields: [leaveTypeId], references: [id], onDelete: SetNull)
  halfDay        String?       // "AM" | "PM" : demi-journée (seulement si début = fin)
  days           Float?        // jours ouvrables décomptés (lun.-ven. ; 0,5 pour une demi-journée)
  decidedById    String?       // admin/gérant qui a approuvé ou refusé
  decidedAt      DateTime?
  decisionNote   String?       // motif du refus ou mot accompagnant l'approbation

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([userId])
  @@map("absence_requests")
}

// ------------------------------------------------------------
// CONGÉS (AUDIT.md 7.30) — types de congés propres à chaque entreprise et
// ajustements de solde individuels. Solde d'un type pour une année de congés =
// daysPerYear + ajustements de l'année − jours approuvés.
// ------------------------------------------------------------
model LeaveType {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String?      // type par défaut ("VACATION", "SICK", "PERSONAL", "UNPAID", "OTHER") : nom traduit FR/EN tant que `name` est vide
  name           String?      // nom personnalisé par l'admin (prioritaire sur le nom traduit)
  color          String       @default("#1F8A6E")
  daysPerYear    Float?       // null = pas de solde (illimité, ex. sans solde)
  isActive       Boolean      @default(true)
  position       Int          @default(0)
  createdAt      DateTime     @default(now())

  requests       AbsenceRequest[]
  adjustments    LeaveBalanceAdjustment[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("leave_types")
}

// Congés programmés par l'entreprise (fermeture des fêtes, journée offerte,
// après-midi libre…), affichés comme des annonces dans « Congés et absences »
// (AUDIT.md 7.31). Les journées ENTIÈRES couvertes ne sont pas décomptées des
// demandes d'absence des personnes concernées.
model CompanyLeave {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  message        String?
  startDate      DateTime     // jour (minuit UTC)
  endDate        DateTime     // jour (minuit UTC), = startDate pour un seul jour
  startTime      String?      // "13:00" : à partir de cette heure le premier jour (facultatif)
  endTime        String?      // "12:00" : jusqu'à cette heure le dernier jour (facultatif)
  departmentIds  String[]     @default([]) // vide = toute l'entreprise
  createdById    String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, startDate])
  @@map("company_leaves")
}

model LeaveBalanceAdjustment {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveTypeId    String
  leaveType      LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  year           Int       // année de congés (année de son premier jour)
  days           Float     // + ou − (ex. +2 ancienneté, +3 report, −1 correction)
  note           String?
  createdById    String?
  createdAt      DateTime  @default(now())

  @@index([organizationId, year])
  @@index([userId])
  @@map("leave_balance_adjustments")
}

// ------------------------------------------------------------
// FILE UPLOAD — listes de présence, horaires, documents partagés.
// Stockés directement dans Postgres (colonne bytea), comme les pièces
// jointes des annonces : pas de service de stockage externe à configurer.
// ------------------------------------------------------------
model FileUpload {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploaderId     String
  uploader       User         @relation("FileUploader", fields: [uploaderId], references: [id], onDelete: Cascade)

  fileName       String
  mimeType       String       // type MIME, ex: "application/pdf", "image/jpeg"
  fileSize       Int          // en octets (affichage + contrôle de limite)
  data           Bytes        // contenu binaire du fichier
  category       String       @default("other") // "schedule" / "policy" / "other"
  weekLabel      String?      // ex: "Semaine du 22 sept 2026", utile pour les horaires

  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@map("file_uploads")
}

// ------------------------------------------------------------
// ANNOUNCEMENT — annonce générale admin -> tous les employés
// ------------------------------------------------------------
model Announcement {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  authorId       String
  author         User         @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  title          String
  content        String
  createdAt      DateTime     @default(now())

  attachments    AnnouncementAttachment[]

  @@index([organizationId])
  @@map("announcements")
}

// ------------------------------------------------------------
// ANNOUNCEMENT ATTACHMENT — fichiers joints à une annonce (PDF, JPG, PNG…)
// Stockés directement dans Postgres (colonne bytea) : pas de service de
// stockage externe à configurer, adapté à des fichiers de quelques Mo
// (listes de présence, etc.). Si le volume grossit beaucoup, ce modèle
// pourra migrer vers S3/R2/Supabase Storage sans changer le reste du code
// (seule la lecture/écriture de "data" changerait).
// ------------------------------------------------------------
model AnnouncementAttachment {
  id             String       @id @default(cuid())
  organizationId String
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  fileName       String
  fileType       String       // type MIME, ex: "application/pdf", "image/jpeg"
  fileSize       Int          // en octets (affichage + contrôle de limite)
  data           Bytes        // contenu binaire du fichier

  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([announcementId])
  @@map("announcement_attachments")
}

// ------------------------------------------------------------
// JOB POSTING — poste ouvert
// ------------------------------------------------------------
model JobPosting {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  title          String
  description    String
  status         JobPostingStatus @default(OPEN)
  createdAt      DateTime         @default(now())

  applications   JobApplication[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("job_postings")
}

// ------------------------------------------------------------
// JOB APPLICATION — candidature interne
// ------------------------------------------------------------
model JobApplication {
  id            String             @id @default(cuid())
  jobPostingId  String
  jobPosting    JobPosting         @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  applicantId   String
  applicant     User               @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  status        ApplicationStatus  @default(RECEIVED)
  message       String?
  createdAt     DateTime           @default(now())

  @@unique([jobPostingId, applicantId]) // un employé ne postule qu'une fois par poste
  @@map("job_applications")
}

// ------------------------------------------------------------
// REVIEW — avis laissé par un employé
// ------------------------------------------------------------
model Review {
  id             String   @id @default(cuid())
  organizationId String
  authorId       String
  author         User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  rating         Int      // 1 à 5
  comment        String
  isAnonymous    Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@map("reviews")
}

// ------------------------------------------------------------
// MESSAGE — communication ciblée admin <-> employé
// ------------------------------------------------------------
model Message {
  id             String   @id @default(cuid())
  organizationId String
  senderId       String
  sender         User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId     String
  receiver       User     @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  content        String
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([receiverId, isRead])
  @@map("messages")
}

// ------------------------------------------------------------
// NOTIFICATION — alerte en app pour UN destinataire précis (Phase 4).
// Volontairement séparée d'AuditLog : AuditLog trace TOUTES les actions de
// l'organisation pour l'admin (traçabilité), alors qu'une Notification
// cible un seul utilisateur et existe pour LUI (lu/non lu), pas pour l'audit.
// ------------------------------------------------------------
model Notification {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  type           String       // même valeur que AuditLog.action (ex: "REPORT_CREATED") -> réutilise lib/activity-log.ts pour l'icône/le libellé
  title          String
  body           String?
  link           String?      // ex: "/dashboard/reports"
  isRead         Boolean      @default(false)

  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([userId, isRead])
  @@map("notifications")
}

// ------------------------------------------------------------
// PUSH SUBSCRIPTION — abonnement notifications push (Web Push API) d'UN
// appareil/navigateur pour UN utilisateur. Un même utilisateur peut avoir
// plusieurs abonnements actifs (téléphone + ordinateur, par ex.). Utilisé
// par lib/push.ts pour envoyer une vraie notification système (avec le
// badge numérique sur l'icône de l'app) même quand l'app est fermée.
// Voir AUDIT.md pour la mise en place complète (clés VAPID, service worker).
// ------------------------------------------------------------
model PushSubscription {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint       String   @unique // identifie l'appareil/navigateur de façon unique
  p256dh         String            // clé publique de chiffrement fournie par le navigateur
  auth           String            // secret d'authentification fourni par le navigateur

  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([userId])
  @@map("push_subscriptions")
}

// ------------------------------------------------------------
// SURVEY — sondage créé par un admin pour tous les employés (voir AUDIT.md 7.23).
// Un sondage = 1 à 10 questions, chacune avec 2 à 6 choix.
// isAnonymous est choisi PAR SONDAGE à la création et ne peut plus changer
// ensuite (sinon des réponses données "anonymement" pourraient devenir
// nominatives) :
//  - anonyme   : SurveyAnswer.participationId reste NULL -> impossible, même
//                en base, de relier une réponse à un employé. On garde
//                seulement SurveyParticipation (qui a déjà répondu) pour
//                empêcher de voter deux fois et calculer le taux de participation.
//  - nominatif : SurveyAnswer.participationId est rempli -> les admins voient
//                qui a répondu quoi.
// ------------------------------------------------------------
model Survey {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  authorId       String
  author         User         @relation("SurveyAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  title          String
  description    String?
  isAnonymous    Boolean      @default(true)
  status         SurveyStatus @default(OPEN)
  closesAt       DateTime?    // date de clôture automatique (optionnelle)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  questions      SurveyQuestion[]
  participations SurveyParticipation[]
  answers        SurveyAnswer[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("surveys")
}

model SurveyQuestion {
  id       String         @id @default(cuid())
  surveyId String
  survey   Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  position Int
  text     String

  options  SurveyOption[]
  answers  SurveyAnswer[]

  @@index([surveyId])
  @@map("survey_questions")
}

model SurveyOption {
  id         String         @id @default(cuid())
  questionId String
  question   SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  position   Int
  label      String

  answers    SurveyAnswer[]

  @@index([questionId])
  @@map("survey_options")
}

// Qui a DÉJÀ répondu (un employé = une participation par sondage). Ne dit
// jamais CE qu'il a répondu pour un sondage anonyme.
model SurveyParticipation {
  id             String   @id @default(cuid())
  organizationId String
  surveyId       String
  survey         Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  privacyNoticeAt DateTime? // avis de confidentialité accepté (sondages nominatifs, AUDIT.md 7.28)
  createdAt      DateTime @default(now())

  answers        SurveyAnswer[]

  @@unique([surveyId, userId]) // impossible de répondre deux fois, même en cas de double clic
  @@index([organizationId])
  @@map("survey_participations")
}

model SurveyAnswer {
  id              String               @id @default(cuid())
  organizationId  String
  surveyId        String
  survey          Survey               @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  questionId      String
  question        SurveyQuestion       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionId        String
  option          SurveyOption         @relation(fields: [optionId], references: [id], onDelete: Cascade)
  participationId String?              // NULL pour un sondage anonyme (voir Survey)
  participation   SurveyParticipation? @relation(fields: [participationId], references: [id], onDelete: Cascade)
  departmentId    String?              // département de l'employé AU MOMENT de répondre, pour la ventilation par département

  @@index([surveyId])
  @@index([questionId])
  @@map("survey_answers")
}

// ------------------------------------------------------------
// SUPPORT — canal privé admin principal -> propriétaire de la plateforme
// (voir AUDIT.md 7.24). Seul l'admin PRINCIPAL d'une organisation peut
// ouvrir une demande (bouton "Contacter Djibril" dans Paramètres) ; le
// propriétaire (SUPER_ADMIN) la lit et répond depuis /platform/support.
// Côté organisation, les réponses sont signées "Djibril — Mindmate
// Compagny" : le compte SUPER_ADMIN lui-même n'est jamais exposé.
// ------------------------------------------------------------
model SupportTicket {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  authorId       String
  author         User                @relation("SupportTicketAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  subject        String
  status         SupportTicketStatus @default(OPEN)
  unreadByPlatform Boolean           @default(true)  // nouveau message de l'admin pas encore lu par le propriétaire
  unreadByAuthor   Boolean           @default(false) // réponse du propriétaire pas encore lue par l'admin
  lastMessageAt  DateTime            @default(now())

  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  messages       SupportMessage[]

  @@index([organizationId])
  @@index([status, lastMessageAt])
  @@map("support_tickets")
}

model SupportMessage {
  id           String        @id @default(cuid())
  ticketId     String
  ticket       SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId     String
  sender       User          @relation("SupportMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  fromPlatform Boolean       @default(false) // true = réponse du propriétaire de la plateforme
  content      String
  createdAt    DateTime      @default(now())

  @@index([ticketId])
  @@map("support_messages")
}

// ------------------------------------------------------------
// DEPARTURE — un départ d'employé + son questionnaire de départ
// (Employee Retention Intelligence, voir AUDIT.md 7.26 et lib/retention.ts).
// Questionnaire FIXE (identique pour tous) pour que les tendances restent
// comparables d'un mois et d'une entreprise à l'autre. Réponses NOMINATIVES :
// les admins voient qui a répondu quoi (choix de l'utilisateur).
// departmentId / hireDate sont des COPIES prises au moment du départ : si le
// département est renommé ou l'employé déplacé ensuite, l'historique reste juste.
// ------------------------------------------------------------
model Departure {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User            @relation("DepartureEmployee", fields: [userId], references: [id], onDelete: Cascade)
  recordedById   String?         // admin qui a enregistré le départ (null = déclaré par l'employé lui-même)
  recordedBy     User?           @relation("DepartureRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  type           DepartureType   @default(RESIGNATION)
  status         DepartureStatus @default(PENDING_SURVEY)
  lastDay        DateTime        // dernier jour de travail
  departmentId   String?         // copie au moment du départ
  hireDate       DateTime?       // copie au moment du départ (ancienneté)

  // --- Questionnaire de départ (codes définis dans lib/retention.ts) ---
  primaryReason     String?      // ex. "CAREER"
  secondaryReasons  String[]     @default([]) // autres raisons, ex. ["PAY", "WORKLOAD"]
  details           String[]     @default([]) // sous-causes précises, ex. ["CAREER_NO_PROMOTION", "PAY_BELOW_MARKET"]
  ratingManager     Int?         // 1 à 5
  ratingGrowth      Int?
  ratingWorkload    Int?
  ratingPay         Int?
  ratingAtmosphere  Int?
  ratingRecognition Int?
  couldBeRetained   String?      // "YES" | "MAYBE" | "NO"
  retentionLever    String?      // ce qui l'aurait retenu, ex. "PROMOTION"
  wouldRecommend    String?      // "YES" | "MAYBE" | "NO"
  wouldReturn       String?      // "YES" | "MAYBE" | "NO"
  comment           String?
  submittedAt       DateTime?
  privacyNoticeAt   DateTime?    // avis de confidentialité accepté avant le questionnaire (AUDIT.md 7.28)

  // --- Fin d'emploi & transition (admin PRINCIPAL seulement, voir AUDIT.md 7.27) ---
  confirmedAt        DateTime?   // fin d'emploi confirmée
  confirmedById      String?     // admin principal qui a confirmé (id texte, pas de relation, comme AuditLog.actorId)
  transitionAt       DateTime?   // rendez-vous de transition (date + heure)
  transitionLocation String?     // ex. "Bureau RH, 2e étage" ou lien visio
  transitionNotes    String?     // consignes pour l'employé
  handoverItems      Json?       // liste de remise : [{ id, label, done, doneAt }] (dossiers, clés, badge, accès informatiques…)
  closedAt           DateTime?   // transition terminée (tout est remis). Le compte n'est PAS désactivé automatiquement.

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organizationId])
  @@index([organizationId, lastDay])
  @@index([userId])
  @@map("departures")
}

// ------------------------------------------------------------
// AUDIT LOG — traçabilité (qui a fait quoi, essentiel pour la sécurité RH)
// ------------------------------------------------------------
model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorId        String?      // qui a fait l'action (nullable si acteur système)
  action         String       // ex: "USER_DELETED", "FILE_UPLOADED", "ANNOUNCEMENT_CREATED"
  targetId       String?      // id de l'objet concerné
  metadata       Json?        // détails additionnels
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@map("audit_logs")
}

// ------------------------------------------------------------
// PASSWORD RESET TOKEN — « Mot de passe oublié » (voir AUDIT.md 7.35)
// Lien à usage unique : par courriel (1 h) ou généré par un admin (24 h).
// On ne stocke JAMAIS le jeton en clair, seulement son empreinte SHA-256 :
// une fuite de la base ne permet pas de réinitialiser un compte.
// ------------------------------------------------------------
model PasswordResetToken {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String?   // admin qui a généré le lien (null = demande par courriel)
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// ------------------------------------------------------------
// SHIFT — un quart de travail (Horaires, voir AUDIT.md 7.36)
// date + minutes depuis minuit, en heure LOCALE de l'entreprise (pas de
// fuseau à convertir). endMinute <= startMinute = se termine le lendemain.
// publishedAt null = brouillon, invisible pour l'employé.
// ------------------------------------------------------------
model Shift {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           String       // "2026-10-12"
  startMinute    Int          // 0..1439
  endMinute      Int          // 0..1439
  position       String?      // poste, ex. « Caisse », « Cuisine »
  note           String?
  publishedAt    DateTime?
  // Choisi par le gérant au moment de publier (AUDIT.md 7.37) : true = tous
  // les employés de l'entreprise voient ce quart dans « Horaire de l'équipe » ;
  // false = seule la personne concernée le voit.
  teamVisible    Boolean      @default(false)
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  swaps          ShiftSwap[]

  @@index([organizationId, date])
  @@index([userId, date])
  @@map("shifts")
}

// ------------------------------------------------------------
// SCHEDULE FILE — horaire téléversé en fichier (Excel, PDF, Word, image),
// voir AUDIT.md 7.39. departmentId null = visible par tous les employés ;
// sinon seulement par ce département (+ admins et ses responsables).
// Fichier supprimé avec son département (jamais « élargi » à tout le monde).
// ------------------------------------------------------------
model ScheduleFile {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  week           String       // lundi de la semaine, "2026-10-12"
  departmentId   String?
  department     Department?  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  title          String
  fileName       String
  mimeType       String
  fileSize       Int
  data           Bytes
  uploadedById   String
  createdAt      DateTime     @default(now())

  @@index([organizationId, week])
  @@map("schedule_files")
}

// ------------------------------------------------------------
// SHIFT SWAP — un employé cède un de ses quarts publiés (AUDIT.md 7.42).
//   OPEN      : proposé (à un collègue précis, ou à son département si
//               targetUserId est null) — personne n'a encore accepté ;
//   ACCEPTED  : un collègue (takenById) l'accepte — en attente du responsable ;
//   APPROVED  : approuvé, le quart est passé au nom de takenById ;
//   REJECTED  : refusé par le responsable (rien ne change) ;
//   DECLINED  : refusé par le collègue visé ;
//   CANCELLED : annulé par l'employé, ou parce que le quart a été modifié.
// Un seul échange actif (OPEN ou ACCEPTED) à la fois par quart.
// ------------------------------------------------------------
enum ShiftSwapStatus {
  OPEN
  ACCEPTED
  APPROVED
  REJECTED
  DECLINED
  CANCELLED
}

model ShiftSwap {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shiftId        String
  shift          Shift           @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  fromUserId     String
  fromUser       User            @relation("ShiftSwapFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  targetUserId   String?         // null = proposé à tout son département
  targetUser     User?           @relation("ShiftSwapTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  takenById      String?
  takenBy        User?           @relation("ShiftSwapTaker", fields: [takenById], references: [id], onDelete: Cascade)
  status         ShiftSwapStatus @default(OPEN)
  note           String?
  decidedById    String?
  decidedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organizationId, status])
  @@index([shiftId])
  @@map("shift_swaps")
}

// ------------------------------------------------------------
// DEMO REQUEST — formulaire « Demander une démo » de la page d'accueil
// publique (AUDIT.md 7.43). Visible par le propriétaire dans
// /platform/demo-requests ; il reçoit aussi un courriel.
// ------------------------------------------------------------
model DemoRequest {
  id          String    @id @default(cuid())
  name        String
  company     String
  email       String
  phone       String?
  companySize String?   // "1-10" | "11-50" | "51-200" | "200+"
  message     String?
  locale      String    @default("fr")
  handledAt   DateTime? // marqué « traité » par le propriétaire
  createdAt   DateTime  @default(now())

  @@index([createdAt])
  @@index([email])
  @@map("demo_requests")
}
